# DINU MARKET — Environment Variables Template (Safe for Git & Vercel Reference)
# Copy to Website/.env for local development, and configure in Vercel Project Settings -> Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
SUPABASE_ANON_KEY=
# Server-side ONLY (optional, for privileged admin product/inventory writes — NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=

# Exact Supabase Table & Storage Bucket Names
SUPABASE_PRODUCTS_TABLE=Product lists
SUPABASE_STORAGE_BUCKET=Product Images

# Server & Security
PORT=3000
SESSION_SECRET=replace-with-strong-random-hmac-secret-in-production
